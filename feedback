<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>MCFPN — Issue Statements Review</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet"/>
<style>
  :root {
    --yellow: #FFD600;
    --cyan: #00C8E0;
    --lime: #5EE06A;
    --pink: #FF2D55;
    --violet: #9B5FFF;
    --black: #111111;
    --white: #FFFFFF;
    --text: #1a1a1a;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--yellow);
    color: var(--text);
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    line-height: 1.5;
  }

  /* APPBAR */
  .appbar {
    background: var(--black);
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 24px;
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 4px solid var(--yellow);
  }
  .appbar-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.4rem;
    letter-spacing: 0.06em;
    color: var(--yellow);
  }
  .appbar-sub {
    font-size: 0.72rem;
    font-weight: 700;
    color: rgba(255,255,255,0.5);
    margin-left: auto;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  /* HERO */
  .hero {
    background: var(--black);
    color: var(--white);
    padding: 52px 36px 44px;
    border-bottom: 6px solid var(--yellow);
  }
  .hero-label {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 0.85rem;
    letter-spacing: 0.22em;
    color: var(--yellow);
    margin-bottom: 10px;
  }
  .hero h1 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2.4rem, 5vw, 4rem);
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--yellow);
    margin-bottom: 20px;
  }
  .hero-context {
    max-width: 680px;
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.85);
    margin-bottom: 24px;
  }
  .hero-context strong { color: var(--yellow); }
  .hero-instructions {
    background: var(--yellow);
    color: var(--black);
    display: inline-block;
    padding: 12px 18px;
    font-size: 0.85rem;
    font-weight: 700;
    border-left: 5px solid var(--pink);
    line-height: 1.5;
    max-width: 640px;
  }

  /* MAIN */
  main {
    max-width: 920px;
    margin: 0 auto;
    padding: 44px 24px 80px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  /* SECTION CARD — white bg, colored border */
  .section-card {
    background: var(--white);
    border-width: 4px;
    border-style: solid;
  }
  .section-card.dist  { border-color: var(--cyan); }
  .section-card.cons  { border-color: var(--lime); }
  .section-card.waste { border-color: var(--pink); }
  .section-card.prod  { border-color: var(--violet); }
  .section-card.proc  { border-color: var(--cyan); }

  /* TAB uses section color as bg */
  .section-tab {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.5rem;
    letter-spacing: 0.1em;
    padding: 10px 24px;
    display: inline-block;
    color: var(--black);
  }
  .dist  .section-tab { background: var(--cyan); }
  .cons  .section-tab { background: var(--lime); }
  .waste .section-tab { background: var(--pink); color: var(--white); }
  .prod  .section-tab { background: var(--violet); color: var(--white); }
  .proc  .section-tab { background: var(--cyan); }

  .section-body { padding: 24px; }

  /* SINGLE COL */
  .single-col {
    margin-bottom: 28px;
  }

  .col-head {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 0.82rem;
    letter-spacing: 0.2em;
    margin-bottom: 10px;
    padding-bottom: 5px;
    border-bottom: 2px solid #e0e0e0;
    color: #888;
  }

  /* ISSUE LIST */
  .issue-list { list-style: none; display: flex; flex-direction: column; gap: 6px; }
  .issue-list li {
    font-size: 0.9rem;
    color: #333;
    padding-left: 14px;
    position: relative;
    line-height: 1.5;
  }
  .issue-list li::before { content: '-'; position: absolute; left: 0; color: #aaa; }
  .issue-list li.sub {
    padding-left: 26px;
    font-size: 0.82rem;
    color: #888;
    font-style: italic;
  }
  .issue-list li.sub::before { content: 'o'; left: 13px; font-size: 0.6rem; top: 4px; }

  /* PROBLEM LIST */
  .problem-list { list-style: none; display: flex; flex-direction: column; gap: 8px; counter-reset: prob; }
  .problem-list li {
    font-size: 0.9rem;
    font-weight: 700;
    padding-left: 30px;
    position: relative;
    counter-increment: prob;
    line-height: 1.4;
  }
  .problem-list li::before {
    content: counter(prob);
    position: absolute; left: 0; top: 1px;
    width: 20px; height: 20px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center; justify-content: center;
    font-size: 0.72rem; font-weight: 700;
  }
  /* colored number badges */
  .dist  .problem-list li::before { background: var(--cyan);   color: var(--black); }
  .cons  .problem-list li::before { background: var(--lime);   color: var(--black); }
  .waste .problem-list li::before { background: var(--pink);   color: var(--white); }
  .prod  .problem-list li::before { background: var(--violet); color: var(--white); }
  .proc  .problem-list li::before { background: var(--cyan);   color: var(--black); }
  /* colored text — inline style on each li for maximum specificity */

  /* SYNTHESIS BLOCK */
  .synthesis {
    margin: 0 0 24px;
    padding: 18px 22px;
    border-left: 5px solid;
  }
  .dist  .synthesis { border-color: var(--cyan);   background: #e8fafd; }
  .cons  .synthesis { border-color: var(--lime);   background: #edfaee; }
  .waste .synthesis { border-color: var(--pink);   background: #fff0f3; }
  .prod  .synthesis { border-color: var(--violet); background: #f4efff; }
  .proc  .synthesis { border-color: var(--cyan);   background: #e8fafd; }

  .synthesis-label {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    margin-bottom: 8px;
  }
  .dist  .synthesis-label { color: var(--cyan); }
  .cons  .synthesis-label { color: #2db84d; }
  .waste .synthesis-label { color: var(--pink); }
  .prod  .synthesis-label { color: var(--violet); }
  .proc  .synthesis-label { color: #0099b0; }

  .synthesis-text {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.55;
    color: var(--black);
  }

  /* FEEDBACK ZONE */
  .feedback-zone {
    border-top: 2px dashed #ddd;
    padding-top: 20px;
  }
  .feedback-label {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 0.82rem;
    letter-spacing: 0.18em;
    color: #aaa;
    margin-bottom: 12px;
  }
  .feedback-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 12px;
  }
  @media (max-width: 620px) { .feedback-grid { grid-template-columns: 1fr; } }

  .form-field { display: flex; flex-direction: column; gap: 4px; }
  .form-field label {
    font-size: 0.7rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.12em;
    color: #999;
  }
  .form-field input,
  .form-field textarea,
  .form-field select {
    background: #f7f7f7;
    border: 1.5px solid #ddd;
    color: var(--black);
    padding: 9px 12px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.88rem;
    outline: none;
    transition: border-color 0.2s;
    resize: vertical;
    border-radius: 0;
    -webkit-appearance: none;
  }
  .form-field input:focus,
  .form-field textarea:focus,
  .form-field select:focus { border-color: var(--black); background: #fff; }
  .form-field select option { background: #fff; color: var(--black); }
  .form-field.full { grid-column: 1 / -1; }

  .submit-btn {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1rem; letter-spacing: 0.12em;
    padding: 10px 28px; border: none;
    cursor: pointer; transition: opacity 0.15s, transform 0.1s;
    color: var(--black);
  }
  .submit-btn:hover { opacity: 0.85; transform: translateY(-1px); }
  .submit-btn:active { transform: translateY(0); }
  .dist  .submit-btn { background: var(--cyan); }
  .cons  .submit-btn { background: var(--lime); }
  .waste .submit-btn { background: var(--pink); color: var(--white); }
  .prod  .submit-btn { background: var(--violet); color: var(--white); }
  .proc  .submit-btn { background: var(--cyan); }

  .thank-you {
    display: none;
    font-size: 0.88rem; font-weight: 700;
    color: #2db84d; padding: 8px 0 0;
  }

  footer {
    background: var(--black);
    color: var(--yellow);
    text-align: center;
    padding: 20px 24px;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 0.85rem; letter-spacing: 0.12em;
    border-top: 4px solid var(--yellow);
  }
</style>
</head>
<body>

<div class="appbar">
  <span class="appbar-title">Muskegon County Food Policy Network</span>
  <span class="appbar-sub">Member Review</span>
</div>

<div class="hero">
  <div class="hero-label">Member Feedback</div>
  <h1>What Are the Issues<br/>in Our Food System?</h1>
  <p class="hero-context">
    At our last meeting, members looked at data together and talked about what is working and what is not in Muskegon County's food system. We wrote up the key issues below. <strong>We need your help to make sure we got it right.</strong>
  </p>
  <div class="hero-instructions">
    Read each section. Use the form at the bottom to tell us what we missed or got wrong. Takes about 5 minutes.
  </div>
</div>

<main>

  <!-- DISTRIBUTION -->
  <div class="section-card dist">
    <div class="section-tab">Distribution</div>
    <div class="section-body">
      <div class="single-col">
        <div>
          <div class="col-head">The Issues</div>
          <ul class="issue-list">
            <li>No central place to collect, store, and move food around the county</li>
            <li>Hard to keep food cold during transport</li>
            <li>Farmers and food buyers are not connected</li>
            <li>Makeshift workarounds have filled the gap, but they do not scale</li>
            <li>Rules and regulations make distribution harder</li>
          </ul>
        </div>
      </div>
      <div class="synthesis">
        <div class="synthesis-label">Why This Matters</div>
        <div class="synthesis-text">We grow food here, but it does not get to the people who need it. Farmers and buyers are not connected. There is no central place to collect and move food around the county.</div>
      </div>
      <div class="feedback-zone">
        <div class="feedback-label">Your Feedback</div>
        <form class="feedback-form" data-section="Distribution" onsubmit="handleSubmit(event, this)">
          <div class="feedback-grid">
            <div class="form-field"><label>Your Name</label><input type="text" name="name" placeholder="First Last" required/></div>
            <div class="form-field"><label>Organization</label><input type="text" name="org" placeholder="Optional"/></div>
            <div class="form-field full"><label>What did we miss? What needs to change?</label><textarea name="comment" rows="4" placeholder="Tell us what you think..." required></textarea></div>
            <div class="form-field"><label>Overall reaction</label>
              <select name="reaction">
                <option value="">Select one</option>
                <option>This looks right</option>
                <option>Mostly right, see my comments</option>
                <option>Something important is missing</option>
                <option>This needs to be rewritten</option>
              </select>
            </div>
          </div>
          <button type="submit" class="submit-btn">Send My Feedback</button>
          <div class="thank-you">Got it. Thank you.</div>
        </form>
      </div>
    </div>
  </div>

  <!-- CONSUMPTION -->
  <div class="section-card cons">
    <div class="section-tab">Consumption</div>
    <div class="section-body">
      <div class="single-col">
        <div>
          <div class="col-head">The Issues</div>
          <ul class="issue-list">
            <li>Many people cannot easily get to food</li>
            <li>No bus routes or transportation to food sources in many areas</li>
            <li>Food programs, markets, and agencies do not share information</li>
            <li>Food is too expensive for many families</li>
            <li>Some people lack the tools or skills to cook at home</li>
            <li>City and county planning does not prioritize food access</li>
          </ul>
        </div>
      </div>
      <div class="synthesis">
        <div class="synthesis-label">Why This Matters</div>
        <div class="synthesis-text">People in Muskegon County go hungry even though food is available. Getting food depends too much on where you live and how you get around. The systems that could help are not working together.</div>
      </div>
      <div class="feedback-zone">
        <div class="feedback-label">Your Feedback</div>
        <form class="feedback-form" data-section="Consumption" onsubmit="handleSubmit(event, this)">
          <div class="feedback-grid">
            <div class="form-field"><label>Your Name</label><input type="text" name="name" placeholder="First Last" required/></div>
            <div class="form-field"><label>Organization</label><input type="text" name="org" placeholder="Optional"/></div>
            <div class="form-field full"><label>What did we miss? What needs to change?</label><textarea name="comment" rows="4" placeholder="Tell us what you think..." required></textarea></div>
            <div class="form-field"><label>Overall reaction</label>
              <select name="reaction">
                <option value="">Select one</option>
                <option>This looks right</option>
                <option>Mostly right, see my comments</option>
                <option>Something important is missing</option>
                <option>This needs to be rewritten</option>
              </select>
            </div>
          </div>
          <button type="submit" class="submit-btn">Send My Feedback</button>
          <div class="thank-you">Got it. Thank you.</div>
        </form>
      </div>
    </div>
  </div>

  <!-- WASTE / RESCUE -->
  <div class="section-card waste">
    <div class="section-tab">Waste &amp; Rescue</div>
    <div class="section-body">
      <div class="single-col">
        <div>
          <div class="col-head">The Issues</div>
          <ul class="issue-list">
            <li>Rescued food is routed out of the county before it can reach local pantries and food programs</li>
            <li class="sub">supply leaves Muskegon, then trickles back in through regional networks at reduced volume and quality</li>
            <li>No local aggregation point or cold storage to receive, hold, and redistribute rescued food at scale</li>
            <li>Lack of public will and incentive for waste reduction; limited community-level efforts</li>
            <li>Composting and organic waste management infrastructure largely absent</li>
            <li>Redistribution seen as mitigation rather than economic or community opportunity</li>
            <li>Regulation and liability barriers limit participation in food rescue</li>
            <li>Infrastructure gaps across composting, biofuels, and alternative operational models</li>
            <li>Point source reduction not addressed at the producer or retail level</li>
            <li>Sociocultural practices and education gaps around food waste</li>
          </ul>
        </div>
      </div>
      <div class="synthesis">
        <div class="synthesis-label">Why This Matters</div>
        <div class="synthesis-text">A lot of food that could be saved and shared here gets sent out of the county instead. There is no local place to collect and store rescued food. Pantries run out. Farmers lose food with nowhere to send it.</div>
      </div>
      <div class="feedback-zone">
        <div class="feedback-label">Your Feedback</div>
        <form class="feedback-form" data-section="Waste and Rescue" onsubmit="handleSubmit(event, this)">
          <div class="feedback-grid">
            <div class="form-field"><label>Your Name</label><input type="text" name="name" placeholder="First Last" required/></div>
            <div class="form-field"><label>Organization</label><input type="text" name="org" placeholder="Optional"/></div>
            <div class="form-field full"><label>What did we miss? What needs to change?</label><textarea name="comment" rows="4" placeholder="Tell us what you think..." required></textarea></div>
            <div class="form-field"><label>Overall reaction</label>
              <select name="reaction">
                <option value="">Select one</option>
                <option>This looks right</option>
                <option>Mostly right, see my comments</option>
                <option>Something important is missing</option>
                <option>This needs to be rewritten</option>
              </select>
            </div>
          </div>
          <button type="submit" class="submit-btn">Send My Feedback</button>
          <div class="thank-you">Got it. Thank you.</div>
        </form>
      </div>
    </div>
  </div>

  <!-- PRODUCTION -->
  <div class="section-card prod">
    <div class="section-tab">Production</div>
    <div class="section-body">
      <div class="single-col">
        <div>
          <div class="col-head">The Issues</div>
          <ul class="issue-list">
            <li>Labor and workforce development gaps</li>
            <li class="sub">reducing reliance on seasonal and migrant workers</li>
            <li>Small and mid-size farmers are fragmented and not aligned</li>
            <li>No efficient mechanism to aggregate for market, distribute, or store</li>
            <li class="sub">insufficient supply chain development, logistics, and communications</li>
          </ul>
        </div>
      </div>
      <div class="synthesis">
        <div class="synthesis-label">Why This Matters</div>
        <div class="synthesis-text">We have good land and farmers who want to grow more. But there are not enough trained workers, no shared way to move and store crops, and no system to help farmers sell locally. One farmer cannot fix this alone.</div>
      </div>
      <div class="feedback-zone">
        <div class="feedback-label">Your Feedback</div>
        <form class="feedback-form" data-section="Production" onsubmit="handleSubmit(event, this)">
          <div class="feedback-grid">
            <div class="form-field"><label>Your Name</label><input type="text" name="name" placeholder="First Last" required/></div>
            <div class="form-field"><label>Organization</label><input type="text" name="org" placeholder="Optional"/></div>
            <div class="form-field full"><label>What did we miss? What needs to change?</label><textarea name="comment" rows="4" placeholder="Tell us what you think..." required></textarea></div>
            <div class="form-field"><label>Overall reaction</label>
              <select name="reaction">
                <option value="">Select one</option>
                <option>This looks right</option>
                <option>Mostly right, see my comments</option>
                <option>Something important is missing</option>
                <option>This needs to be rewritten</option>
              </select>
            </div>
          </div>
          <button type="submit" class="submit-btn">Send My Feedback</button>
          <div class="thank-you">Got it. Thank you.</div>
        </form>
      </div>
    </div>
  </div>

  <!-- PROCESSING -->
  <div class="section-card proc">
    <div class="section-tab">Processing</div>
    <div class="section-body">
      <div class="single-col">
        <div>
          <div class="col-head">The Issues</div>
          <ul class="issue-list">
            <li>Cold chain infrastructure gaps</li>
            <li>Access to capital and entrepreneurial education</li>
            <li>Food safety credentials and regulatory requirements</li>
            <li>Heavily regulated at multiple levels of government</li>
            <li>Labor-intensive work requiring specialized skills to reach viability</li>
            <li>Difficulty aligning demand to efficient, profitable supply management</li>
            <li>Disparity among minority-owned businesses</li>
            <li>Limited access to certified commercial space</li>
            <li>High demand for skilled labor with limited local supply</li>
          </ul>
        </div>
      </div>
      <div class="synthesis">
        <div class="synthesis-label">Why This Matters</div>
        <div class="synthesis-text">Processing is where local food either makes it into the system or gets lost. It costs a lot, requires special certifications, and is heavily regulated. Small businesses and minority-owned operations face the biggest barriers.</div>
      </div>
      <div class="feedback-zone">
        <div class="feedback-label">Your Feedback</div>
        <form class="feedback-form" data-section="Processing" onsubmit="handleSubmit(event, this)">
          <div class="feedback-grid">
            <div class="form-field"><label>Your Name</label><input type="text" name="name" placeholder="First Last" required/></div>
            <div class="form-field"><label>Organization</label><input type="text" name="org" placeholder="Optional"/></div>
            <div class="form-field full"><label>What did we miss? What needs to change?</label><textarea name="comment" rows="4" placeholder="Tell us what you think..." required></textarea></div>
            <div class="form-field"><label>Overall reaction</label>
              <select name="reaction">
                <option value="">Select one</option>
                <option>This looks right</option>
                <option>Mostly right, see my comments</option>
                <option>Something important is missing</option>
                <option>This needs to be rewritten</option>
              </select>
            </div>
          </div>
          <button type="submit" class="submit-btn">Send My Feedback</button>
          <div class="thank-you">Got it. Thank you.</div>
        </form>
      </div>
    </div>
  </div>

</main>

<footer>
  Muskegon County Food Policy Network &nbsp;|&nbsp; tierralocal.org
</footer>

<script>
  const SUBMIT_URL = 'YOUR_APPS_SCRIPT_URL_HERE';

  function handleSubmit(e, form) {
    e.preventDefault();
    const data = {
      section:   form.dataset.section,
      name:      form.name.value.trim(),
      org:       form.org.value.trim(),
      reaction:  form.reaction.value,
      comment:   form.comment.value.trim(),
      timestamp: new Date().toISOString()
    };
    const btn    = form.querySelector('.submit-btn');
    const thanks = form.querySelector('.thank-you');
    btn.textContent = 'Sending...';
    btn.disabled = true;

    if (SUBMIT_URL === 'https://script.google.com/macros/s/AKfycbzxAokX7-0pyPoM_VGVC2EmpcyRBZ6CBJQRxDbVN0ErHu87g5bYpcEuOt4IWO3Vwvp1/exec') {
      console.log('Feedback:', data);
      showThanks(form, btn, thanks);
      return;
    }
    fetch(SUBMIT_URL, {
      method: 'POST', mode: 'no-cors',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    })
    .then(() => showThanks(form, btn, thanks))
    .catch(() => showThanks(form, btn, thanks));
  }

  function showThanks(form, btn, thanks) {
    form.querySelectorAll('input, textarea, select').forEach(el => el.disabled = true);
    btn.style.display = 'none';
    thanks.style.display = 'block';
  }
</script>
</body>
</html>
